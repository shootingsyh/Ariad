{
  "name": "@ariad/openclaw-plugin",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "files": ["dist", "runtime", "openclaw.plugin.json", "README.md"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test test/runtime.test.mjs",
    "test:e2e": "npm run build && node test/openclaw-e2e.mjs",
    "plugin:build": "npm run build && openclaw plugins build --entry ./dist/index.js",
    "plugin:validate": "npm run build && openclaw plugins validate --entry ./dist/index.js"
  },
  "dependencies": {
    "typebox": "^1.1.38"
  },
  "peerDependencies": {
    "openclaw": ">=2026.9.4"
  },
  "devDependencies": {
    "openclaw": "2026.9.4",
    "typescript": "^5.9.2"
  },
  "openclaw": {
    "extensions": ["./dist/index.js"],
    "compat": {
      "pluginApi": ">=2026.9.4",
      "minGatewayVersion": "2026.9.4"
    },
    "build": {
      "openclawVersion": "2026.9.4",
      "pluginSdkVersion": "2026.9.4"
    }
  }
}
